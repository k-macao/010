# 复制为 .env 或直接在 shell 中 export。所有变量都以 QP_ 前缀，避免污染其它系统。
# 数据库：默认 SQLite，生产用 PostgreSQL
QP_DATABASE_URL=sqlite:///data/quant.db
# QP_DATABASE_URL=postgresql+psycopg2://quant:quant@localhost:5432/quant

# 离线模式（只读取 examples/fixtures，不访问外网）
QP_OFFLINE=0
QP_CONFIG=config/pipeline.toml

# ClickHouse 因子镜像（可选）
QP_CLICKHOUSE_ENABLED=0
QP_CLICKHOUSE_URL=http://localhost:8123

# 估值目标币种：财报数值统一折算到该币种后再与市值相除
QP_TARGET_CURRENCY=HKD

# LLM 附注解析：任何 OpenAI 兼容端点（vLLM / Ollama / 本地网关 / 云厂商）
QP_LLM_ENABLED=0
QP_LLM_BASE_URL=http://localhost:11434/v1
QP_LLM_MODEL=qwen2.5:7b
QP_LLM_API_KEY=

# 质量门禁告警 webhook（可选）
QP_ALERT_WEBHOOK_URL=

# PushPlus 微信推送：关注 PushPlus 公众号并在服务端绑定后，填入自己的 token。
# .env 为 shell 文件，请仅保存在可信服务器上，禁止提交或公开。
QP_PUSHPLUS_TOKEN=
QP_NOTIFY_SYMBOLS=00700,09988
# QP_PYTHON=/absolute/path/to/python
